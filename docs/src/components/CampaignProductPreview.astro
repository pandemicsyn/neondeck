---
type Props = {
  campaign: 'pr-review' | 'pr-autopilot';
};

const { campaign } = Astro.props;
---

<div
  class:list={['campaign-preview', campaign]}
  role="img"
  aria-label={campaign === 'pr-review'
    ? 'Neondeck pull request review preview'
    : 'Neondeck PR Autopilot preview'}
>
  <div class="preview-chrome">
    <span class="preview-brand"><i></i>neondeck</span>
    <span
      >{campaign === 'pr-review' ? 'REVIEW WORKBENCH' : 'ACTIVE WATCHES'}</span
    >
    <span class="preview-online"><i></i>local · online</span>
  </div>

  {
    campaign === 'pr-review' ? (
      <div class="review-shell">
        <aside class="file-rail">
          <div class="rail-title">
            <>
              <span>CHANGED FILES</span>
              <b>5</b>
            </>
          </div>
          <div class="file active">
            <>
              <span>src/review.ts</span>
              <small>T2 · D1 · N1</small>
            </>
          </div>
          <div class="file">
            <>
              <span>src/github.ts</span>
              <small>T1 · D0 · N0</small>
            </>
          </div>
          <div class="file">
            <>
              <span>web/Review.tsx</span>
              <small>T0 · D2 · N1</small>
            </>
          </div>
          <div class="file muted-file">
            <>
              <span>+ 2 files</span>
              <small>clean</small>
            </>
          </div>
          <div class="rail-legend">T threads · D drafts · N Neon</div>
        </aside>

        <section class="diff-pane">
          <header class="diff-header">
            <span>src/review.ts</span>
            <span>@@ -84,6 +84,11 @@</span>
          </header>
          <div class="diff-code" aria-hidden="true">
            <div class="line">
              <>
                <i>84</i>
                <i>84</i>
                <code>const anchor = resolveAnchor(thread);</code>
              </>
            </div>
            <div class="line removed">
              <>
                <i>85</i>
                <i />
                <code>- return anchor;</code>
              </>
            </div>
            <div class="line added">
              <>
                <i />
                <i>85</i>
                <code>+ if (anchor.revision !== headSha) &#123;</code>
              </>
            </div>
            <div class="line added">
              <>
                <i />
                <i>86</i>
                <code>+ &nbsp;return markStale(anchor);</code>
              </>
            </div>
            <div class="line added">
              <>
                <i />
                <i>87</i>
                <code>+ &#125;</code>
              </>
            </div>
            <div class="line">
              <>
                <i>86</i>
                <i>88</i>
                <code>&nbsp;return anchor;</code>
              </>
            </div>
          </div>
          <div class="finding">
            <span class="finding-label">NEON FINDING · HIGH</span>
            <strong>Stale anchors should not move to a new revision.</strong>
            <p>
              This guard keeps the draft attached to the exact code the reviewer
              saw.
            </p>
            <div>
              <>
                <span class="preview-action">Draft comment</span>
                <span class="preview-action">Dismiss</span>
              </>
            </div>
          </div>
          <footer class="review-submit">
            <span>
              2 drafts · bound to <code>7c9e31a</code>
            </span>
            <div>
              <>
                <span class="preview-action">Comment</span>
                <span class="preview-action">Approve</span>
                <span class="preview-action request">Request changes</span>
              </>
            </div>
          </footer>
        </section>
      </div>
    ) : (
      <div class="autopilot-shell">
        <aside class="watch-rail">
          <div class="rail-title">
            <>
              <span>WATCHED PRS</span>
              <b>3</b>
            </>
          </div>
          <div class="watch active">
            <>
              <span>#521 · neondeck</span>
              <small>waiting</small>
            </>
          </div>
          <div class="watch">
            <>
              <span>#1284 · flue</span>
              <small class="working">working</small>
            </>
          </div>
          <div class="watch">
            <>
              <span>#88 · panels</span>
              <small>watching</small>
            </>
          </div>
        </aside>

        <section class="watch-detail">
          <header class="watch-header">
            <div>
              <>
                <span>neondeck #521</span>
                <strong>fix: bind review drafts to revision</strong>
              </>
            </div>
            <span class="waiting-state">
              <i />
              WAITING FOR YOU
            </span>
          </header>
          <div class="watch-mode">
            <span>MODE</span>
            <strong>autofix-with-approval</strong>
            <span class="preview-action">change</span>
          </div>
          <div class="watch-timeline">
            <div class="timeline-row complete">
              <>
                <i />
                <span>Feedback detected</span>
                <small>2 review comments</small>
              </>
            </div>
            <div class="timeline-row complete">
              <>
                <i />
                <span>Prepared in isolated worktree</span>
                <small>1 commit</small>
              </>
            </div>
            <div class="timeline-row complete">
              <>
                <i />
                <span>Required checks passed</span>
                <small>2 / 2</small>
              </>
            </div>
            <div class="timeline-row current">
              <>
                <i />
                <span>Human approval required</span>
                <small>push withheld</small>
              </>
            </div>
          </div>
          <div class="prepared-change">
            <div>
              <>
                <span>PREPARED COMMIT</span>
                <code>7c9e31a</code>
              </>
            </div>
            <strong>Guard stale review anchors before refresh</strong>
            <p>3 files changed · +28 −9 · primary checkout untouched</p>
          </div>
          <footer class="watch-actions">
            <span class="preview-action">Review diff</span>
            <span class="preview-action">Review agent</span>
            <span class="preview-action approve">Open approval chat</span>
          </footer>
        </section>
      </div>
    )
  }
</div>

<style>
  .campaign-preview {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #08090d;
    color: #d7f7ff;
    font-family: 'IBM Plex Mono', monospace;
  }

  .preview-chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 38px;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #070810;
    color: rgba(215, 247, 255, 0.46);
    padding: 0 14px;
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .preview-brand,
  .preview-online {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .preview-brand {
    color: var(--pink);
    font-weight: 600;
  }

  .preview-brand i {
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--pink);
    box-shadow: 0 0 8px var(--pink);
  }

  .preview-online {
    justify-self: end;
    color: var(--teal);
  }

  .preview-online i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--teal);
    box-shadow: 0 0 7px var(--teal);
  }

  .review-shell,
  .autopilot-shell {
    display: grid;
    grid-template-columns: minmax(170px, 0.28fr) minmax(0, 1fr);
    min-height: 430px;
  }

  .file-rail,
  .watch-rail {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 79, 184, 0.025);
  }

  .rail-title {
    display: flex;
    justify-content: space-between;
    padding: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(215, 247, 255, 0.46);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .rail-title b {
    color: var(--pink);
  }

  .file,
  .watch {
    display: grid;
    width: 100%;
    gap: 5px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: transparent;
    color: rgba(215, 247, 255, 0.78);
    padding: 12px 14px;
    text-align: left;
  }

  .file small,
  .watch small {
    color: rgba(215, 247, 255, 0.4);
    font-size: 9px;
  }

  .file.active,
  .watch.active {
    background: rgba(105, 230, 255, 0.09);
    color: var(--cyan);
  }

  .file.active small,
  .watch.active small {
    color: var(--pink);
  }

  .muted-file {
    color: rgba(215, 247, 255, 0.42);
  }

  .rail-legend {
    padding: 14px;
    color: rgba(215, 247, 255, 0.32);
    font-size: 8px;
    line-height: 1.6;
  }

  .diff-pane,
  .watch-detail {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .diff-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--cyan);
    font-size: 10px;
  }

  .diff-header span:last-child {
    color: rgba(215, 247, 255, 0.36);
  }

  .diff-code {
    padding: 11px 0;
    background: #0a0b10;
    font-size: 10px;
    line-height: 1.75;
  }

  .line {
    display: grid;
    grid-template-columns: 34px 34px minmax(0, 1fr);
    min-width: 0;
  }

  .line i {
    color: rgba(215, 247, 255, 0.25);
    font-style: normal;
    text-align: right;
    padding-right: 10px;
    user-select: none;
  }

  .line code {
    overflow: hidden;
    color: rgba(215, 247, 255, 0.76);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .line.removed {
    background: rgba(255, 79, 184, 0.08);
  }

  .line.removed code {
    color: #ff9cd5;
  }

  .line.added {
    background: rgba(0, 183, 199, 0.09);
  }

  .line.added code {
    color: #8cecf4;
  }

  .finding {
    margin: 14px;
    border: 1px solid rgba(255, 79, 184, 0.3);
    background: rgba(255, 79, 184, 0.07);
    padding: 13px 14px;
  }

  .finding-label {
    color: var(--pink);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .finding strong {
    display: block;
    margin-top: 8px;
    color: #f7fbff;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
  }

  .finding p {
    margin: 5px 0 10px;
    color: rgba(215, 247, 255, 0.57);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    line-height: 1.5;
  }

  .preview-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(105, 230, 255, 0.3);
    background: transparent;
    color: var(--cyan);
    padding: 6px 9px;
    font-size: 9px;
  }

  .finding .preview-action + .preview-action {
    margin-left: 7px;
    border-color: rgba(215, 247, 255, 0.16);
    color: rgba(215, 247, 255, 0.56);
  }

  .review-submit,
  .watch-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding: 12px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background: #070810;
    color: rgba(215, 247, 255, 0.42);
    font-size: 9px;
  }

  .review-submit code {
    color: var(--violet);
  }

  .review-submit .preview-action + .preview-action,
  .watch-actions .preview-action + .preview-action {
    margin-left: 6px;
  }

  .review-submit .request {
    border-color: var(--pink);
    background: var(--pink);
    color: #0e0f13;
  }

  .autopilot-shell {
    grid-template-columns: minmax(175px, 0.3fr) minmax(0, 1fr);
  }

  .watch-rail {
    background: rgba(0, 183, 199, 0.025);
  }

  .watch small.working {
    color: var(--teal);
  }

  .watch-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .watch-header div {
    display: grid;
    gap: 5px;
  }

  .watch-header div span {
    color: var(--cyan);
    font-size: 9px;
  }

  .watch-header strong {
    color: #f7fbff;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
  }

  .waiting-state {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    color: var(--pink);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .waiting-state i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--pink);
    box-shadow: 0 0 8px var(--pink);
  }

  .watch-mode {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px 16px;
    font-size: 9px;
  }

  .watch-mode span {
    color: rgba(215, 247, 255, 0.38);
  }

  .watch-mode strong {
    color: var(--violet);
    font-weight: 500;
  }

  .watch-timeline {
    padding: 11px 16px 5px;
  }

  .timeline-row {
    position: relative;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    min-height: 35px;
    color: rgba(215, 247, 255, 0.62);
    font-size: 10px;
  }

  .timeline-row::before {
    position: absolute;
    top: 23px;
    bottom: -12px;
    left: 5px;
    width: 1px;
    background: rgba(255, 255, 255, 0.1);
    content: '';
  }

  .timeline-row:last-child::before {
    display: none;
  }

  .timeline-row i {
    width: 11px;
    height: 11px;
    border: 1px solid rgba(215, 247, 255, 0.24);
    border-radius: 999px;
    background: #08090d;
  }

  .timeline-row.complete i {
    border-color: var(--teal);
    background: var(--teal);
    box-shadow: 0 0 7px rgba(0, 183, 199, 0.6);
  }

  .timeline-row.current {
    color: var(--pink);
  }

  .timeline-row.current i {
    border-color: var(--pink);
    box-shadow: 0 0 7px var(--pink);
  }

  .timeline-row small {
    color: rgba(215, 247, 255, 0.36);
    font-size: 8px;
  }

  .prepared-change {
    margin: 10px 16px 16px;
    border: 1px solid rgba(139, 77, 255, 0.28);
    background: rgba(139, 77, 255, 0.07);
    padding: 13px 14px;
  }

  .prepared-change div {
    display: flex;
    justify-content: space-between;
    color: var(--violet);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .prepared-change strong {
    display: block;
    margin-top: 8px;
    color: #f7fbff;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
  }

  .prepared-change p {
    margin: 5px 0 0;
    color: rgba(215, 247, 255, 0.48);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 10px;
  }

  .watch-actions {
    justify-content: flex-end;
  }

  .watch-actions .approve {
    border-color: var(--cyan);
    background: var(--cyan);
    color: #0e0f13;
  }

  :global(:root[data-theme='light']) .campaign-preview {
    border-color: rgba(18, 40, 55, 0.2);
  }

  @media (max-width: 760px) {
    .review-shell,
    .autopilot-shell {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .file-rail,
    .watch-rail {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .campaign-preview {
      margin-inline: -8px;
    }

    .preview-chrome {
      grid-template-columns: 1fr auto;
      padding-inline: 10px;
    }

    .preview-chrome > span:nth-child(2) {
      display: none;
    }

    .review-submit,
    .watch-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .review-submit div,
    .watch-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      gap: 6px;
    }

    .review-submit .preview-action,
    .watch-actions .preview-action {
      min-height: 34px;
    }

    .review-submit .preview-action + .preview-action,
    .watch-actions .preview-action + .preview-action {
      margin-left: 0;
    }

    .watch-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .watch-mode {
      grid-template-columns: auto 1fr;
    }

    .watch-mode .preview-action {
      display: none;
    }

    .timeline-row {
      grid-template-columns: 14px minmax(0, 1fr);
    }

    .timeline-row small {
      display: none;
    }
  }
</style>
