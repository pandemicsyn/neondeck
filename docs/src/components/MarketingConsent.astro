<aside
  class="marketing-consent"
  data-marketing-consent
  aria-label="Advertising measurement choice"
  hidden
>
  <div>
    <strong>Help us measure this campaign?</strong>
    <p>
      If you allow it, Reddit can receive visits and key CTA clicks on these
      campaign pages. The Neondeck app remains telemetry-free.
    </p>
    <a href="/privacy/">What gets shared</a>
  </div>
  <div class="marketing-consent__actions">
    <button type="button" data-marketing-consent-choice="declined">
      no thanks
    </button>
    <button type="button" data-marketing-consent-choice="allowed">
      allow measurement
    </button>
  </div>
</aside>

<script is:inline>
  (() => {
    const pixelId = 't2_4ljtr';
    const storageKey = 'neondeck-marketing-consent';
    const consent = document.querySelector('[data-marketing-consent]');
    let pixelStarted = false;

    function readChoice() {
      try {
        return window.localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    }

    function saveChoice(choice) {
      try {
        window.localStorage.setItem(storageKey, choice);
      } catch {
        // The choice still applies to this page when storage is unavailable.
      }
    }

    function startRedditPixel() {
      if (pixelStarted) return;
      pixelStarted = true;

      if (!window.rdt) {
        const rdt = (window.rdt = function () {
          if (rdt.sendEvent) {
            rdt.sendEvent.apply(rdt, arguments);
          } else {
            rdt.callQueue.push(arguments);
          }
        });
        rdt.callQueue = [];

        const script = document.createElement('script');
        script.src = `https://www.redditstatic.com/ads/pixel.js?pixel_id=${pixelId}`;
        script.async = true;
        const firstScript = document.getElementsByTagName('script')[0];
        firstScript.parentNode.insertBefore(script, firstScript);
      }

      window.rdt('init', pixelId);
      window.rdt('track', 'PageVisit');
    }

    function trackRedditConversion(event) {
      if (!pixelStarted || !window.rdt) return;
      const customEventName = {
        install_command_copy: 'InstallCommandCopy',
        github_click: 'GitHubClick',
      }[event.detail?.name];
      if (!customEventName) return;
      window.rdt('track', 'Custom', { customEventName });
    }

    window.addEventListener('neondeck:marketing', trackRedditConversion);

    const existingChoice = readChoice();
    if (existingChoice === 'allowed') {
      startRedditPixel();
    } else if (existingChoice !== 'declined' && consent) {
      consent.hidden = false;
    }

    consent?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest('[data-marketing-consent-choice]');
      if (!button) return;
      const choice = button.dataset.marketingConsentChoice;
      saveChoice(choice);
      consent.hidden = true;
      if (choice === 'allowed') startRedditPixel();
    });
  })();
</script>

<style>
