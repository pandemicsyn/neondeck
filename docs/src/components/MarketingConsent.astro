    gap: 8px;
  }

  .marketing-consent button {
    min-height: 38px;
    padding-inline: 12px;
    border: 1px solid rgba(215, 247, 255, 0.18);
    border-radius: 0;
    background: transparent;
    color: #d7f7ff;
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
