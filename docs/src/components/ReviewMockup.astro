  :global(:root[data-theme='light']) .traverse,
  :global(:root[data-theme='light']) .tv-select,
  :global(:root[data-theme='light']) .tv-key,
  :global(:root[data-theme='light']) .tv-help,
  :global(:root[data-theme='light']) .files-pane .file,
  :global(:root[data-theme='light']) .file-path,
  :global(:root[data-theme='light']) .tree-legend,
  :global(:root[data-theme='light']) .tree-filter,
  :global(:root[data-theme='light']) .draft-src,
  :global(:root[data-theme='light']) .draft-actions span,
