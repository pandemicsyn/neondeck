    color: var(--pink);
  }

  .review-foot > p {
    margin: 6px 0 0;
    color: rgba(215, 247, 255, 0.38);
    font-size: clamp(4px, 0.62vw, 9px);
  }

  /* Three panes at phone width is unreadable, so stack and let it grow. */
  @media (max-width: 760px) {
    .review-screen {
      aspect-ratio: auto;
    }

    .review-body {
      grid-template-columns: 1fr;
    }

    .files-pane,
    .traverse {
      display: none;
    }

    .review-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .review-chips {
      justify-content: flex-start;
    }

    .verdict {
      flex-wrap: wrap;
      gap: 5px;
    }

    .verdict .submit {
      margin-left: 0;
    }

    .diff-pane {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

