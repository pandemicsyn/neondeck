    overflow: hidden;
    font-family: inherit;
    text-overflow: ellipsis;
    white-space: pre;
  }

  .diff code :global(.k) {
    color: var(--pink);
  }

  .diff code :global(.t) {
    color: var(--violet);
  }

  .diff code :global(.p) {
    color: var(--cyan);
  }

  .diff code :global(.s) {
    color: var(--teal);
  }

  .diff code :global(.f) {
    color: #9ad6ff;
  }

  .diff code :global(.v) {
    color: rgba(215, 247, 255, 0.92);
  }

  .diff code :global(.m) {
    color: rgba(215, 247, 255, 0.45);
  }

  .draft {
    margin: 4px clamp(5px, 0.7vw, 9px);
    border: 1px solid rgba(139, 77, 255, 0.45);
    background: rgba(139, 77, 255, 0.09);
  }

  .draft > header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 3px clamp(5px, 0.8vw, 10px);
    border-bottom: 1px solid rgba(139, 77, 255, 0.25);
    font-size: clamp(4px, 0.6vw, 8.5px);
    letter-spacing: 0.1em;
  }

  .draft-tag {
    color: var(--violet);
    font-weight: 600;
  }

  .draft-src {
    color: rgba(215, 247, 255, 0.42);
  }

  .draft p {
    margin: 0;
    padding: clamp(4px, 0.6vw, 8px) clamp(5px, 0.8vw, 10px);
    color: rgba(215, 247, 255, 0.82);
    font-size: clamp(5px, 0.76vw, 9.6px);
    line-height: 1.6;
  }

  .draft-actions {
    display: flex;
    gap: 5px;
    padding: 0 clamp(5px, 0.8vw, 10px) clamp(4px, 0.6vw, 8px);
  }

