    color: var(--cyan);
  }

  .ic-json {
    background: rgba(139, 77, 255, 0.18);
    color: var(--violet);
  }

  .ic-md,
  .ic-yml {
    background: rgba(255, 79, 184, 0.16);
    color: var(--pink);
  }

  .ic-txt {
    background: rgba(255, 255, 255, 0.09);
    color: rgba(215, 247, 255, 0.55);
  }

