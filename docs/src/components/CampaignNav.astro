---
type Props = {
  campaign: 'pr-review' | 'pr-autopilot';
  context?: string;
  showContext?: boolean;
};

const { campaign, context, showContext = true } = Astro.props;
---

<nav class="campaign-nav" aria-label="Campaign navigation">
  <div class="campaign-container campaign-nav__inner">
    <a class="campaign-brand" href="/" aria-label="neondeck home">
      <img src="/favicon.svg" width="30" height="30" alt="" />
      <span>neondeck</span>
    </a>
    {
      showContext && (
        <span class="campaign-nav__context">
          {context ??
            (campaign === 'pr-review' ? 'review mode' : 'pr auto pilot')}
        </span>
      )
    }
    <a
      class:list={[
        'campaign-link-button',
        'campaign-nav__cta',
        !showContext && 'campaign-nav__cta--pushed',
      ]}
      href="https://github.com/pandemicsyn/neondeck"
      data-marketing-event="github_click"
      data-marketing-placement="nav"
    >
      <i aria-hidden="true"></i>
      star on github
    </a>
  </div>
</nav>
