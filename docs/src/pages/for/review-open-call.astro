---
import CampaignCommand from '../../components/CampaignCommand.astro';
import CampaignFooter from '../../components/CampaignFooter.astro';
import MarketingConsent from '../../components/MarketingConsent.astro';
import CampaignNav from '../../components/CampaignNav.astro';
import BriefingMockup from '../../components/BriefingMockup.astro';
import ReviewMockup from '../../components/ReviewMockup.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/campaign.css';

const repo = 'https://github.com/pandemicsyn/neondeck';
const discussions = `${repo}/discussions`;

const questions = [
  {
    n: '#01',
    signal: 'cyan',
    title: 'Should the agent approve the small stuff for you?',
    body: 'Assume it can tell whether a change is complex enough to need a human. Do you want it waving the safe ones through, or do you want eyes on every change?',
    href: 'https://github.com/pandemicsyn/neondeck/discussions/326',
  },
  {
    n: '#02',
    signal: 'pink',
    title: 'What earns your attention in 40,000 machine-written lines?',
    body: 'Tell us what you actually look at, and where an agent should help. Does the diff still matter? Is anyone reviewing line by line any more?',
    href: 'https://github.com/pandemicsyn/neondeck/discussions/327',
  },
  {
    n: '#03',
    signal: 'violet',
    title: "Should the agent's findings be labelled as the agent's?",
    body: 'Marked as machine-generated, or submitted under your name as if you found them yourself? It changes how much weight the author gives them.',
    href: 'https://github.com/pandemicsyn/neondeck/discussions/328',
  },
  {
    n: '#04',
    signal: 'teal',
    title: 'Guided tours, risk maps, diagrams: which would you use?',
    body: 'Walkthroughs of the change, flagged high-risk areas, code maps, mermaid diagrams. We can build all of it. Tell us which you would actually open twice.',
    href: 'https://github.com/pandemicsyn/neondeck/discussions/330',
  },
];

const steps = [
  { n: '1', label: 'install', code: '$ npm install --global neondeck@next' },
  { n: '2', label: 'setup', code: '$ neondeck init' },
  { n: '3', label: 'start', code: '$ neondeck serve' },
  { n: '4', label: 'open the deck', code: '$ neondeck open' },
];
---

<BaseLayout
  title="Help us build the review setup that doesn't suck · neondeck"
  description="Agents increased the review load and reviews haven't evolved. Neondeck is an open source review bench with fast Git-backed diffs and an agent that reads the PR with you. Tell us what it should become."
  ogImage="/og/review-open-call.png"
  ogImageAlt="Writing code evolved. Reviewing it didn't."
  marketingPage="review-open-call"
>
  <div class="campaign-shell open-call">
    <CampaignNav campaign="pr-review" showContext={false} />
    <main>
      <header class="campaign-container campaign-hero">
        <p class="campaign-kicker">call for reviewers</p>
        <h1>
          Help build the review setup that <span>doesn't suck.</span>
        </h1>
        <p class="campaign-hero__copy">
          Neondeck is a local app trying to rethink what doing reviews looks
          like. It works with ChatGPT subs or gateways like OpenRouter or Kilo
          Gateway, to deliver a fresh take on how you perform reviews for your
          coworkers or agent PRs. Your opinion can help shape what it becomes.
        </p>
        <p class="campaign-hero__copy">
          Run it on one real pull request this week. Then come chat with us
          about what a review should even be, now that most of the diff is
          written by a machine.
        </p>
        <div class="campaign-hero__actions">
          <a
            class="oc-primary"
            href={repo}
            data-marketing-event="github_click"
            data-marketing-placement="hero-repo">view on github →</a
          >
          <CampaignCommand placement="hero" />
        </div>
      </header>

      <section class="campaign-container oc-section oc-intro">
        <p class="campaign-kicker">the problem</p>
        <h2>Agents increased the review load. Reviews haven't evolved.</h2>
        <p class="oc-lead">
          More PRs. Bigger changes. Agents are helping us write more code than
          ever, but we're all feeling the review pressure. Neon triages your PR
          review backlog, flags the ones that need a human look, and gives you a
          fast as fuck diff viewer when you need it. Approve PRs, leave
          comments, without ever pulling up GitHub.
        </p>
      </section>

      <section class="campaign-container campaign-preview-wrap">
        <figure class="oc-shot">
          <figcaption>
            <span class="oc-shot__n">01</span>
            <strong>The briefing.</strong>
            <span>what Neon found, and why it escalated to you.</span>
          </figcaption>
          <BriefingMockup />
        </figure>
        <figure class="oc-shot">
          <figcaption>
            <span class="oc-shot__n pink">02</span>
            <strong>The workbench.</strong>
            <span
              >the full PR diff, with preloaded comments and sidebar agent chat.</span
            >
          </figcaption>
          <ReviewMockup />
        </figure>
      </section>

      <section class="campaign-container oc-section">
        <p class="campaign-kicker">open questions</p>
        <h2>Four things we can't settle on our own.</h2>
        <p class="oc-lead">
          Help us figure out what reviews become, while reviews are still
          needed. Each one is its own thread — take whichever you have an
          opinion about.
        </p>
        <div class="oc-board">
          {
            questions.map((q) => (
              <a
                class="oc-question"
                href={q.href}
                data-marketing-event="github_click"
                data-marketing-placement="discussion-question"
              >
                <span class:list={['oc-num', q.signal]}>{q.n}</span>
                <span class="oc-question__body">
                  <strong>{q.title}</strong>
                  <span>{q.body}</span>
                </span>
                <span class="oc-thread">open thread →</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="campaign-container oc-section">
        <div class="oc-help">
          <div>
            <p class="campaign-kicker">how to help</p>
            <h2 class="oc-help__title">
              Run it on a real PR. Tell us where it broke.
            </h2>
            <p class="oc-lead">
              Node 26+ and a GitHub token. Everything runs local from there. The
              useful report is not "it worked", it is the pull request where the
              briefing missed the thing that actually mattered.
            </p>
            <a
              class="campaign-link-button oc-help__cta"
              href={discussions}
              data-marketing-event="github_click"
              data-marketing-placement="discussion-cta">start a thread →</a
            >
          </div>
          <ol class="oc-steps">
            {
              steps.map((s) => (
                <li>
                  <span class="oc-step__n">{s.n}</span>
                  <div>
                    <small>{s.label}</small>
                    <code>{s.code}</code>
                  </div>
                </li>
              ))
            }
            <li>
              <span class="oc-step__n cyan">5</span>
              <div>
                <small class="cyan">tell us</small>
                <span class="oc-step__prose"
                  >what the briefing missed, and on which PR</span
                >
              </div>
            </li>
          </ol>
        </div>
      </section>
    </main>
    <CampaignFooter />
    <MarketingConsent />
  </div>
</BaseLayout>

<style>
  /* Warmer ground than the ad pages: this one leads with the ask, not the demo. */
  .open-call {
    background:
      linear-gradient(var(--campaign-line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--campaign-line-soft) 1px, transparent 1px),
      radial-gradient(
        circle at 11% 5%,
        rgba(255, 79, 184, 0.09),
        transparent 31%
      ),
      radial-gradient(
        circle at 76% 2%,
        rgba(139, 77, 255, 0.08),
        transparent 27%
      ),
      var(--campaign-bg);
    background-size:
      64px 64px,
      64px 64px,
      auto,
      auto,
      auto;
  }

  .open-call :global(.campaign-kicker) {
    color: var(--pink);
  }

  .open-call .campaign-hero h1 span {
    color: var(--pink);
  }

  .open-call .campaign-hero__copy + .campaign-hero__copy {
    margin-top: 18px;
  }

  .oc-primary {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    padding-inline: 22px;
    background: var(--pink);
    box-shadow: 0 0 26px rgba(255, 79, 184, 0.32);
    color: #090a0f;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 150ms ease;
  }

  .oc-primary:hover {
    color: #090a0f;
    transform: translateY(-1px);
  }

  /* The intro runs straight into the mockups it is describing, so it drops the
     section's usual trailing space. */
  .oc-intro {
    padding-bottom: 0;
  }

  .oc-intro .oc-lead {
    margin-bottom: clamp(24px, 3vw, 34px);
  }

  .oc-shot + .oc-shot {
    margin-top: clamp(38px, 5vw, 62px);
  }

  .oc-shot {
    margin: 0;
  }

  .oc-shot figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }

  .oc-shot__n {
    color: var(--cyan);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .oc-shot__n.pink {
    color: var(--pink);
  }

  .oc-shot figcaption strong {
    color: var(--campaign-ink);
    font-family: 'Chakra Petch', sans-serif;
    font-size: 17px;
    font-weight: 600;
  }

  .oc-shot figcaption > span:last-child {
    max-width: 68ch;
    color: var(--campaign-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .oc-section {
    padding-bottom: clamp(64px, 8vw, 98px);
  }

  .oc-section h2 {
    max-width: 22ch;
    margin: 0 0 18px;
    color: var(--campaign-ink);
    font-family: 'Chakra Petch', sans-serif;
    font-size: clamp(2.1rem, 4.5vw, 3.55rem);
    font-weight: 700;
    line-height: 1.02;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .oc-lead {
    max-width: 62ch;
    margin: 0 0 42px;
    color: var(--campaign-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  /* Solid panel: on the bare grid the 64px lines cut straight through the copy. */
  .oc-board {
    border: 1px solid var(--campaign-line);
    background:
      linear-gradient(180deg, rgba(255, 79, 184, 0.05), transparent 58%),
      var(--campaign-panel);
  }

  .oc-question {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 150px;
    gap: 20px;
    align-items: baseline;
    padding: 22px 24px;
    border-bottom: 1px solid var(--campaign-line);
    color: inherit;
    transition: background 150ms ease;
  }

  .oc-question:last-child {
    border-bottom: 0;
  }

  .oc-question:hover {
    background: rgba(255, 79, 184, 0.04);
    color: inherit;
  }

  .oc-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .oc-num.cyan {
    color: var(--cyan);
  }
  .oc-num.pink {
    color: var(--pink);
  }
  .oc-num.violet {
    color: #b59cff;
  }
  .oc-num.teal {
    color: var(--teal);
  }

  .oc-question__body strong {
    display: block;
    color: var(--campaign-ink);
    font-family: 'Chakra Petch', sans-serif;
    font-size: 19px;
    font-weight: 600;
  }

  .oc-question__body > span {
    display: block;
    max-width: 68ch;
    margin-top: 6px;
    color: var(--campaign-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .oc-thread {
    justify-self: end;
    color: var(--cyan);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .oc-help {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 52px);
    align-items: start;
    padding: clamp(30px, 4vw, 48px);
    border: 1px solid var(--campaign-line);
    background:
      linear-gradient(180deg, rgba(0, 183, 199, 0.065), transparent 62%),
      var(--campaign-panel);
  }

  .oc-help__title {
    max-width: 18ch;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
  }

  .oc-help__cta {
    min-height: 44px;
    padding-inline: 20px;
  }

  .oc-steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 1px solid var(--campaign-line);
    list-style: none;
  }

  .oc-steps li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 14px;
    padding: 15px 18px;
    border-bottom: 1px solid var(--campaign-line);
  }

  .oc-steps li:last-child {
    border-bottom: 0;
  }

  .oc-step__n {
    color: var(--campaign-faint);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .oc-step__n.cyan,
  .oc-steps small.cyan {
    color: var(--cyan);
  }

  .oc-steps small {
    display: block;
    color: var(--campaign-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .oc-steps code {
    color: var(--campaign-ink);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
  }

  .oc-step__prose {
    color: var(--campaign-ink);
    font-size: 14px;
  }

  /* Miami hues at 9-11px fall under 4.5:1 on the light paper ground, so darken
     them there. Fully :global() because the signal classes are applied through
     class:list at runtime, and Astro prunes scoped selectors it cannot match
     against the template. */
  :global(:root[data-theme='light'] .open-call .campaign-kicker),
  :global(:root[data-theme='light'] .oc-num.pink) {
    color: color-mix(in srgb, var(--pink) 72%, #000000);
  }

  :global(:root[data-theme='light'] .oc-thread),
  :global(:root[data-theme='light'] .oc-num.cyan),
  :global(:root[data-theme='light'] .oc-num.teal),
  :global(:root[data-theme='light'] .oc-steps small.cyan) {
    color: color-mix(in srgb, var(--teal) 74%, #000000);
  }

  :global(:root[data-theme='light'] .oc-num.violet) {
    color: var(--violet);
  }

  @media (max-width: 900px) {
    .oc-help {
      grid-template-columns: minmax(0, 1fr);
    }

    .oc-question {
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 12px;
      row-gap: 10px;
    }

    .oc-thread {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
