---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
---

<BaseLayout
  title="Privacy · neondeck"
  description="How Neondeck handles app telemetry, campaign measurement, and the optional Reddit Pixel."
>
  <div class="site-shell">
    <SiteNav />
    <main class="container privacy-page">
      <p class="kicker">PRIVACY · MARKETING MEASUREMENT</p>
      <h1>The app stays quiet. Campaign tracking is your choice.</h1>
      <p class="privacy-lede">
        Neondeck does not include product analytics, advertising pixels, or
        marketing telemetry. The three campaign pages on neondeck.dev offer a
        separate, optional Reddit Pixel solely to measure those ads.
      </p>

      <section>
        <h2>What happens before you choose</h2>
        <p>
          Nothing is sent to Reddit by Neondeck. The campaign page records your
          measurement choice in your browser's local storage so it can respect
          that choice on later visits.
        </p>
      </section>

      <section>
        <h2>If you allow measurement</h2>
        <p>
          Campaign pages load Reddit's browser pixel and report three event
          types: a page visit, copying the install command, and clicking a
          GitHub link. We do not provide Reddit with an email address, account
          identifier, or data from the installed Neondeck app.
        </p>
        <p>
          Like other browser pixels, Reddit may receive the campaign URL and
          ordinary request information such as IP address, browser details, and
          cookies. Reddit handles that information under its own policies.
        </p>
        <a
          class="privacy-external"
          href="https://www.reddit.com/policies/privacy-policy"
          >Read Reddit's privacy policy →</a
        >
      </section>

      <section>
        <h2>Change your choice</h2>
        <p>
          This changes whether the Reddit Pixel may load on future campaign-page
          visits in this browser. Declining does not remove cookies Reddit may
          already have set; those can be cleared with your browser controls.
        </p>
        <div class="privacy-choice" aria-live="polite">
          <span
            >Your current choice: <strong data-privacy-choice>not set</strong
            ></span
          >
          <div>
            <button type="button" data-privacy-set="declined">decline</button>
            <button type="button" data-privacy-set="allowed">allow</button>
          </div>
        </div>
      </section>

      <section>
        <h2>Questions</h2>
        <p>
          Open a discussion or issue in the
          <a href="https://github.com/pandemicsyn/neondeck"
            >Neondeck repository</a
          >. This page describes the site as deployed on August 23, 2026.
        </p>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const storageKey = 'neondeck-marketing-consent';
    const output = document.querySelector('[data-privacy-choice]');

    function readChoice() {
      try {
        return window.localStorage.getItem(storageKey) || 'not set';
      } catch {
        return 'unavailable';
      }
    }

    function renderChoice() {
      if (output) output.textContent = readChoice();
    }

    document.querySelectorAll('[data-privacy-set]').forEach((button) => {
      button.addEventListener('click', () => {
        try {
          window.localStorage.setItem(storageKey, button.dataset.privacySet);
        } catch {
          // The status text below reports when local storage is unavailable.
        }
        renderChoice();
      });
    });

    renderChoice();
  })();
</script>

<style>
  .privacy-page {
    max-width: 820px;
    padding-block: clamp(70px, 10vw, 120px);
  }

  .privacy-page h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.98;
    text-align: left;
    text-wrap: balance;
  }

  .privacy-lede {
    max-width: 65ch;
    margin: 28px 0 70px;
    color: var(--body);
    font-size: 19px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .privacy-page section {
    padding-block: 30px;
    border-top: 1px solid var(--line);
  }

  .privacy-page h2 {
    margin: 0 0 15px;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    text-align: left;
  }

  .privacy-page section p {
    max-width: 70ch;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .privacy-page section p + p {
    margin-top: 14px;
  }

  .privacy-page section a,
  .privacy-external {
    color: var(--cyan);
  }

  .privacy-external {
    display: inline-block;
    margin-top: 15px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
  }

  .privacy-choice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    margin-top: 22px;
    padding: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
  }

  .privacy-choice strong {
    color: var(--cyan);
    font-weight: 500;
  }

  .privacy-choice > div {
    display: flex;
    gap: 8px;
  }

  .privacy-choice button {
    min-height: 38px;
    padding-inline: 14px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--body);
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .privacy-choice button:last-child {
    border-color: var(--pink);
    color: var(--pink);
  }

  .privacy-choice button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .privacy-page h1 {
      font-size: clamp(2.5rem, 13vw, 4rem);
    }

    .privacy-lede {
      margin-bottom: 48px;
      font-size: 17px;
    }

    .privacy-choice {
      align-items: stretch;
      flex-direction: column;
    }

    .privacy-choice > div {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
