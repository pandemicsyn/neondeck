{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".kilo/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "overrides": [
    {
      "files": [
        "src/cli/**/*.ts",
        "src/cli/**/*.tsx",
        "src/modules/app-state/**/*.ts",
        "src/modules/app-state/**/*.tsx",
        "src/modules/autopilot/**/*.ts",
        "src/modules/autopilot/**/*.tsx",
        "src/modules/config/**/*.ts",
        "src/modules/config/**/*.tsx",
        "src/modules/kilo/**/*.ts",
        "src/modules/kilo/**/*.tsx",
        "src/modules/learning/**/*.ts",
        "src/modules/learning/**/*.tsx",
        "src/modules/memory/**/*.ts",
        "src/modules/memory/**/*.tsx",
        "src/modules/pr-events/**/*.ts",
        "src/modules/pr-events/**/*.tsx",
        "src/modules/runtime/**/*.ts",
        "src/modules/runtime/**/*.tsx",
        "src/modules/scheduled-tasks/**/*.ts",
        "src/modules/scheduled-tasks/**/*.tsx",
        "src/modules/scheduler/**/*.ts",
        "src/modules/scheduler/**/*.tsx",
        "src/modules/sessions/**/*.ts",
        "src/modules/sessions/**/*.tsx",
        "src/modules/watches/**/*.ts",
        "src/modules/watches/**/*.tsx",
        "src/server/**/*.ts",
        "src/server/**/*.tsx"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "rules": {
        "anti-slop/no-chained-type-assertions": "error",
        "anti-slop/no-conditional-empty-object-spread": "error",
        "anti-slop/no-known-value-widening": "error",
        "anti-slop/no-module-mocking": "error",
        "anti-slop/no-object-parameters": "error",
        "anti-slop/no-reflect-apply": "error",
        "anti-slop/no-reflect-get": "error",
        "anti-slop/no-runtime-typeof": "error",
        "anti-slop/no-shape-in-symbol-names": "error",
        "anti-slop/no-unknown-parameters": "error",
        "anti-slop/no-unknown-returns": "error",
        "anti-slop/no-unknown-type-aliases": "error",
        "anti-slop/no-unsafe-dictionary-type": "error",
        "anti-slop/no-widen-then-assert": "error",
        "anti-slop/require-safety-comment-for-type-assertion": "error"
      }
    }
  ]
}
