    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.0.3",
    "tensorlake": ">=0.5.107 <0.6.0"
