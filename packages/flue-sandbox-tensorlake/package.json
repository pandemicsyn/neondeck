{
  "name": "@neondeck/flue-sandbox-tensorlake",
  "version": "0.0.0",
  "description": "Tensorlake sandbox adapter for Flue",
  "keywords": [
    "flue",
    "tensorlake",
    "sandbox",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/neondeck.git",
    "directory": "packages/flue-sandbox-tensorlake"
  },
  "homepage": "https://github.com/pandemicsyn/neondeck#readme",
  "bugs": {
    "url": "https://github.com/pandemicsyn/neondeck/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
